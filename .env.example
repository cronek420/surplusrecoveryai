# LEXICON SOLUTIONS - SR-AI CONFIGURATION
# Copy this file to .env and fill in your API keys

# GEMINI API (Required) - Google Generative AI
# Get your key from: https://cloud.google.com/docs/authentication/api-keys
API_KEY=your_gemini_api_key_here

# ANYMAILFINDER API (Recommended) - Email Discovery & Verification
# Get your key from: https://www.anymailfinder.com/api
# Features:
#   - Professional email discovery from name + company
#   - Email deliverability verification
#   - Confidence scoring
ANYMAILFINDER_API_KEY=your_anymailfinder_api_key_here

# AIRSCALE API (Recommended) - Property Intelligence & Real Estate Data
# Get your key from: https://api.airscale.io
# Features:
#   - Property ownership history
#   - Tax assessment data
#   - Market valuation
#   - Lien records
#   - Owner contact information
#   - Market comparables
AIRSCALE_API_KEY=your_airscale_api_key_here

# Optional: Development configuration
NODE_ENV=development
PORT=3000
